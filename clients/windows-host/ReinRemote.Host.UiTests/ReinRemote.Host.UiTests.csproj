<Project Sdk="Microsoft.NET.Sdk">
  <!-- The app driven through UI Automation (FlaUI, UIA3) against a real `rein-remote host`. Windows only;
       it needs REIN_REMOTE_EXE (the server) and REIN_REMOTE_APP (ReinRemoteHost.exe). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="..\ReinRemote.Host.Core\ReinRemote.Host.Core.csproj" />
  </ItemGroup>
</Project>
