<Project Sdk="Microsoft.NET.Sdk">
  <!-- Rein Remote's Windows host app: WinUI 3, unpackaged, the Windows App SDK carried with it (no
       runtime to install). rein-remote.exe ships next to it (copied from the Rust build when there). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ReinRemote.Host</RootNamespace>
    <AssemblyName>ReinRemoteHost</AssemblyName>
    <Product>Rein Remote</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\rein-remote.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9169" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ReinRemote.Host.Core\ReinRemote.Host.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\*.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- The server, from cargo build (release, rr-server), shipped beside the app. -->
    <None Include="..\..\..\target\release\rein-remote.exe" Link="rein-remote.exe" CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\..\..\target\release\rein-remote.exe')" />
  </ItemGroup>
</Project>
