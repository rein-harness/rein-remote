<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ReinRemote.Host.Pages.SessionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:ReinRemote.Host.Core"
    NavigationCacheMode="Required">
    <ScrollViewer Padding="24,8,24,24">
        <StackPanel MaxWidth="980">
            <TextBlock Text="Live sessions" Style="{StaticResource PageTitle}" AutomationProperties.HeadingLevel="Level1" AutomationProperties.AutomationId="PageTitle" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12" Text="Each session as the policy sees it: the rule that let it in, its groups, what it may do." />
            <InfoBar x:Name="SessionsResult" IsClosable="True" Margin="0,0,0,12" AutomationProperties.AutomationId="SessionsResult" AutomationProperties.Name="Result" />
            <TextBlock x:Name="NoSessions" Text="No sessions." Style="{StaticResource BodyTextBlockStyle}" AutomationProperties.AutomationId="NoSessions" />
            <ListView x:Name="SessionList" SelectionMode="None" AutomationProperties.AutomationId="SessionList" AutomationProperties.Name="Live sessions">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="core:Viewer">
                        <Grid ColumnSpacing="16" Padding="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind Who}" Style="{StaticResource Hint}" />
                                <TextBlock Text="{x:Bind Policy}" Style="{StaticResource Hint}" />
                                <TextBlock Text="{x:Bind Stats}" Style="{StaticResource Hint}" />
                                <TextBlock Text="{x:Bind Id}" Style="{StaticResource Hint}" FontFamily="Cascadia Mono, Consolas" IsTextSelectionEnabled="True" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Kick" Tag="{x:Bind}" Click="Kick_Click" VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="SessionKick" AutomationProperties.Name="{x:Bind KickName}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
