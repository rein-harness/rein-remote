<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ReinRemote.Host.Pages.SharingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:ReinRemote.Host.Core"
    NavigationCacheMode="Required">
    <ScrollViewer Padding="24,8,24,24">
        <StackPanel MaxWidth="980" HorizontalAlignment="Stretch">
            <TextBlock Text="Sharing" Style="{StaticResource PageTitle}" AutomationProperties.HeadingLevel="Level1" AutomationProperties.AutomationId="PageTitle" />

            <!-- On or off -->
            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="StatusDot" Width="14" Height="14" VerticalAlignment="Center" Fill="{ThemeResource ControlStrongFillColorDisabledBrush}" AutomationProperties.AccessibilityView="Raw" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="SharingStatus" Text="Not connected" Style="{StaticResource SubtitleTextBlockStyle}"
                                   AutomationProperties.AutomationId="SharingStatus" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock x:Name="SharingDetail" Style="{StaticResource Hint}" AutomationProperties.AutomationId="SharingDetail" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="RestartButton" Content="Restart to apply settings" Visibility="Collapsed" Click="Restart_Click"
                                AutomationProperties.AutomationId="RestartButton" AutomationProperties.Name="Restart sharing to apply settings" />
                        <Button x:Name="StartStopButton" Content="Start sharing" Style="{StaticResource AccentButtonStyle}" MinWidth="140" Click="StartStop_Click"
                                AutomationProperties.AutomationId="StartStopButton" AutomationProperties.Name="Start sharing" />
                    </StackPanel>
                </Grid>
            </Border>
            <InfoBar x:Name="SharingResult" IsClosable="True" Margin="0,0,0,12" AutomationProperties.AutomationId="SharingResult" AutomationProperties.Name="Sharing result" />

            <!-- What's shared -->
            <TextBlock Text="What's shared" Style="{StaticResource Section}" AutomationProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="SourcePicker" HorizontalAlignment="Stretch" PlaceholderText="Pick a display or a window"
                                  Header="Source" SelectionChanged="SourcePicker_SelectionChanged" DropDownOpened="SourcePicker_DropDownOpened"
                                  AutomationProperties.AutomationId="SourcePicker" AutomationProperties.Name="What's shared">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="core:SourceItem">
                                    <TextBlock Text="{x:Bind Display}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="1" VerticalAlignment="Bottom" Click="RefreshSources_Click" ToolTipService.ToolTip="List the displays and windows again"
                                AutomationProperties.AutomationId="RefreshSources" AutomationProperties.Name="Refresh the list of sources">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                    </Grid>
                    <TextBlock x:Name="CurrentSource" Style="{StaticResource Hint}" AutomationProperties.AutomationId="CurrentSource" />
                    <TextBlock x:Name="SourcesError" Style="{StaticResource Hint}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed"
                               AutomationProperties.AutomationId="SourcesError" />
                </StackPanel>
            </Border>

            <!-- The links -->
            <TextBlock Text="Links" Style="{StaticResource Section}" AutomationProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource Hint}" Text="Each link is a key to this screen: send it only to whoever should see it. A new one is made each time rein-remote host starts." />
                        <TextBlock x:Name="NoLinks" Text="Start sharing to get the links." Visibility="Collapsed" AutomationProperties.AutomationId="NoLinks" />
                        <ListView x:Name="Links" SelectionMode="Single" SelectionChanged="Links_SelectionChanged"
                                  AutomationProperties.AutomationId="Links" AutomationProperties.Name="Links to this screen">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="core:Link">
                                    <Grid ColumnSpacing="8" Padding="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind Label}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Text="{x:Bind Url}" IsTextSelectionEnabled="True" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas"
                                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Copy" Tag="{x:Bind Url}" Click="CopyLink_Click" VerticalAlignment="Center"
                                                AutomationProperties.AutomationId="CopyLink" AutomationProperties.Name="{x:Bind CopyName}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6" x:Name="LinkQrPanel" Visibility="Collapsed">
                        <Border Background="White" Padding="8" CornerRadius="6" HorizontalAlignment="Center">
                            <Image x:Name="LinkQr" Width="176" Height="176" AutomationProperties.AutomationId="LinkQr" AutomationProperties.Name="QR code of the selected link" />
                        </Border>
                        <TextBlock x:Name="LinkQrCaption" Style="{StaticResource Hint}" HorizontalAlignment="Center" MaxWidth="200" TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Pairing -->
            <TextBlock Text="Pair a device" Style="{StaticResource Section}" AutomationProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource Hint}" Text="In the Rein Remote app on a phone or another computer, pick this machine and type the code, or scan the QR code. A code pairs one device and lasts 10 minutes; a paired device connects again without one." />
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock x:Name="PairingCode" Text="–" FontFamily="Cascadia Mono, Consolas" FontSize="36" FontWeight="SemiBold" IsTextSelectionEnabled="True"
                                       AutomationProperties.AutomationId="PairingCode" AutomationProperties.Name="Pairing code" />
                            <TextBlock x:Name="PairingCountdown" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}"
                                       AutomationProperties.AutomationId="PairingCountdown" />
                        </StackPanel>
                        <TextBlock x:Name="PairingNote" Style="{StaticResource Hint}" AutomationProperties.AutomationId="PairingNote" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="NewCodeButton" Content="New code" Click="NewCode_Click"
                                    AutomationProperties.AutomationId="NewCodeButton" AutomationProperties.Name="New pairing code" />
                            <Button x:Name="CopyCodeButton" Content="Copy code" Click="CopyCode_Click"
                                    AutomationProperties.AutomationId="CopyCodeButton" AutomationProperties.Name="Copy the pairing code" />
                        </StackPanel>
                        <TextBlock x:Name="Fingerprint" Style="{StaticResource Hint}" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="Fingerprint" />
                    </StackPanel>
                    <Border Grid.Column="1" x:Name="PairingQrPanel" Background="White" Padding="8" CornerRadius="6" VerticalAlignment="Top" Visibility="Collapsed">
                        <Image x:Name="PairingQr" Width="150" Height="150" AutomationProperties.AutomationId="PairingQr" AutomationProperties.Name="QR code to pair a phone" />
                    </Border>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
