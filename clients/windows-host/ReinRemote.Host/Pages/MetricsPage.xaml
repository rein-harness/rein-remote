<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ReinRemote.Host.Pages.MetricsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:ReinRemote.Host.Core"
    NavigationCacheMode="Required">
    <Grid Padding="24,8,24,24" RowSpacing="10" MaxWidth="980">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Metrics" Style="{StaticResource PageTitle}" AutomationProperties.HeadingLevel="Level1" AutomationProperties.AutomationId="PageTitle" />
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="MetricsInfo" Style="{StaticResource Hint}" VerticalAlignment="Center" AutomationProperties.AutomationId="MetricsInfo"
                       Text="The same counters as /metrics, since rein-remote host started. Updated every 2 seconds." />
            <Button Grid.Column="1" Content="Refresh" Click="Refresh_Click" AutomationProperties.AutomationId="RefreshMetrics" AutomationProperties.Name="Refresh the metrics" />
        </Grid>
        <ListView x:Name="MetricsList" Grid.Row="2" SelectionMode="None" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="6"
                  AutomationProperties.AutomationId="MetricsList" AutomationProperties.Name="Metrics">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="core:KeyValueRow">
                    <Grid ColumnSpacing="16" Padding="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Key}" FontFamily="Cascadia Mono, Consolas" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Value}" Style="{StaticResource BodyTextBlockStyle}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
