<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ReinRemote.Host.Pages.SignInPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">
    <ScrollViewer Padding="24,8,24,24">
        <StackPanel MaxWidth="980" Spacing="0">
            <TextBlock Text="Sign-in" Style="{StaticResource PageTitle}" AutomationProperties.HeadingLevel="Level1" AutomationProperties.AutomationId="PageTitle" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                       Text="Viewers sign in with your identity provider (OIDC or SAML) instead of holding a link. The provider is reached when sharing starts; a problem shows on the Sharing page. Secrets are write-only: they're kept in the home folder, never shown again." />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="14">
                    <StackPanel>
                        <TextBlock Text="Sign-in with" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <RadioButton x:Name="KindOff" GroupName="kind" Content="Off (links and pairing)" Checked="Kind_Checked"
                                         AutomationProperties.AutomationId="SignInOff" AutomationProperties.Name="Sign-in off" />
                            <RadioButton x:Name="KindOidc" GroupName="kind" Content="OIDC" Checked="Kind_Checked"
                                         AutomationProperties.AutomationId="SignInOidc" AutomationProperties.Name="Sign-in with OIDC" />
                            <RadioButton x:Name="KindSaml" GroupName="kind" Content="SAML" Checked="Kind_Checked"
                                         AutomationProperties.AutomationId="SignInSaml" AutomationProperties.Name="Sign-in with SAML" />
                        </StackPanel>
                        <TextBlock x:Name="SamlNote" Style="{StaticResource Hint}" Visibility="Collapsed" Text="This build of rein-remote has no SAML (built without --features saml)." />
                    </StackPanel>
                    <TextBox x:Name="PublicUrl" Header="This server's public address" PlaceholderText="https://remote.example.com"
                             AutomationProperties.AutomationId="PublicUrl" AutomationProperties.Name="Public address" />
                    <StackPanel x:Name="OidcPanel" Spacing="12">
                        <TextBox x:Name="OidcIssuer" Header="Issuer" PlaceholderText="https://example.okta.com"
                                 AutomationProperties.AutomationId="OidcIssuer" AutomationProperties.Name="OIDC issuer" />
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OidcClientId" Header="Client id" AutomationProperties.AutomationId="OidcClientId" AutomationProperties.Name="OIDC client id" />
                            <StackPanel Grid.Column="1">
                                <PasswordBox x:Name="OidcSecret" Header="Client secret" PlaceholderText="Type a new one to change it"
                                             AutomationProperties.AutomationId="OidcSecret" AutomationProperties.Name="OIDC client secret (write only)" />
                                <TextBlock x:Name="OidcSecretState" Style="{StaticResource Hint}" AutomationProperties.AutomationId="OidcSecretState" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OidcScopes" Header="Scopes" PlaceholderText="openid email profile" AutomationProperties.AutomationId="OidcScopes" AutomationProperties.Name="OIDC scopes" />
                            <TextBox x:Name="OidcUserClaim" Grid.Column="1" Header="User claim" PlaceholderText="email" AutomationProperties.AutomationId="OidcUserClaim" AutomationProperties.Name="OIDC user claim" />
                            <TextBox x:Name="OidcGroupsClaim" Grid.Column="2" Header="Groups claim" PlaceholderText="groups" AutomationProperties.AutomationId="OidcGroupsClaim" AutomationProperties.Name="OIDC groups claim" />
                        </Grid>
                    </StackPanel>
                    <StackPanel x:Name="SamlPanel" Spacing="12">
                        <TextBox x:Name="SamlMetadata" Header="Identity provider's metadata (a URL or a file)" AutomationProperties.AutomationId="SamlMetadata" AutomationProperties.Name="SAML identity provider metadata" />
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SamlEntityId" Header="Entity id" AutomationProperties.AutomationId="SamlEntityId" AutomationProperties.Name="SAML entity id" />
                            <TextBox x:Name="SamlUserAttr" Grid.Column="1" Header="User attribute" AutomationProperties.AutomationId="SamlUserAttr" AutomationProperties.Name="SAML user attribute" />
                            <TextBox x:Name="SamlGroupsAttr" Grid.Column="2" Header="Groups attribute" PlaceholderText="groups" AutomationProperties.AutomationId="SamlGroupsAttr" AutomationProperties.Name="SAML groups attribute" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="SaveSignIn" Content="Save" Style="{StaticResource AccentButtonStyle}" MinWidth="100" Click="Save_Click"
                                AutomationProperties.AutomationId="SaveSignIn" AutomationProperties.Name="Save sign-in" />
                        <Button Content="Undo changes" Click="Reload_Click" AutomationProperties.AutomationId="ReloadSignIn" AutomationProperties.Name="Undo sign-in changes" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <InfoBar x:Name="SignInResult" IsClosable="True" AutomationProperties.AutomationId="SignInResult" AutomationProperties.Name="Sign-in result" />
        </StackPanel>
    </ScrollViewer>
</Page>
