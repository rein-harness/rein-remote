<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ReinRemote.Host.Pages.ViewersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:ReinRemote.Host.Core"
    NavigationCacheMode="Required">
    <ScrollViewer Padding="24,8,24,24">
        <StackPanel MaxWidth="980">
            <TextBlock Text="Viewers" Style="{StaticResource PageTitle}" AutomationProperties.HeadingLevel="Level1" AutomationProperties.AutomationId="PageTitle" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                       Text="Who's watching now, one row per session. Kicking ends the session; they can come back with what they have (a link, a pairing). To keep a device out, unpair it; to retire the links, restart rein-remote host." />
            <InfoBar x:Name="ViewersResult" IsClosable="True" Margin="0,0,0,12" AutomationProperties.AutomationId="ViewersResult" AutomationProperties.Name="Result" />
            <TextBlock x:Name="NoViewers" Text="No one is watching." Style="{StaticResource BodyTextBlockStyle}" AutomationProperties.AutomationId="NoViewers" />
            <ListView x:Name="ViewerList" SelectionMode="None" AutomationProperties.AutomationId="ViewerList" AutomationProperties.Name="Viewers">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="core:Viewer">
                        <Border Style="{StaticResource Card}" Margin="0">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE7F8;" FontSize="22" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Who}" Style="{StaticResource Hint}" />
                                    <TextBlock Text="{x:Bind Stats}" Style="{StaticResource Hint}" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="Kick" Tag="{x:Bind}" Click="Kick_Click" VerticalAlignment="Center"
                                        AutomationProperties.AutomationId="KickButton" AutomationProperties.Name="{x:Bind KickName}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
