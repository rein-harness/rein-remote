<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ReinRemote.Host.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Padding="24,8,24,24">
            <StackPanel MaxWidth="980">
                <TextBlock Text="Settings" Style="{StaticResource PageTitle}" AutomationProperties.HeadingLevel="Level1" AutomationProperties.AutomationId="PageTitle" />
                <TextBlock x:Name="SettingsPath" Style="{StaticResource Hint}" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="SettingsPath" />
                <TextBlock x:Name="Overridden" Style="{StaticResource Hint}" Visibility="Collapsed" AutomationProperties.AutomationId="Overridden" />

                <TextBlock Text="Picture" Style="{StaticResource Section}" AutomationProperties.HeadingLevel="Level2" />
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="14">
                        <StackPanel>
                            <TextBlock Text="On a slow link, keep" Margin="0,0,0,4" />
                            <RadioButton x:Name="PreferFramerate" GroupName="prefer" Content="The frame rate (games, motion): the bitrate and the picture's size give way first"
                                         AutomationProperties.AutomationId="PreferFramerate" AutomationProperties.Name="Keep the frame rate" />
                            <RadioButton x:Name="PreferQuality" GroupName="prefer" Content="The quality (text, detail): frames give way first"
                                         AutomationProperties.AutomationId="PreferQuality" AutomationProperties.Name="Keep the quality" />
                        </StackPanel>
                        <Grid ColumnSpacing="16" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="FpsBox" Header="Frames a second" PlaceholderText="auto, or 1 to 240"
                                     AutomationProperties.AutomationId="FpsBox" AutomationProperties.Name="Frames a second (auto, or 1 to 240)" />
                            <TextBox x:Name="BitrateBox" Grid.Column="1" Header="Most kbit/s" PlaceholderText="auto, or 100 to 1000000"
                                     AutomationProperties.AutomationId="BitrateBox" AutomationProperties.Name="Most kilobits a second (auto, or 100 to 1000000)" />
                            <ComboBox x:Name="CodecBox" Grid.Column="2" Header="Codec" HorizontalAlignment="Stretch"
                                      AutomationProperties.AutomationId="CodecBox" AutomationProperties.Name="Codec">
                                <ComboBoxItem Content="H.264 (every viewer)" Tag="h264" />
                                <ComboBoxItem Content="H.265 / HEVC" Tag="h265" />
                                <ComboBoxItem Content="Auto (HEVC where both have it in hardware)" Tag="auto" />
                            </ComboBox>
                        </Grid>
                        <ToggleSwitch x:Name="AudioToggle" Header="Sound" OnContent="This computer's sound goes to viewers" OffContent="No sound"
                                      AutomationProperties.AutomationId="AudioToggle" AutomationProperties.Name="Send this computer's sound" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Network" Style="{StaticResource Section}" AutomationProperties.HeadingLevel="Level2" />
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="14">
                        <TextBox x:Name="ListenBox" Header="Listen on" PlaceholderText="auto (every network, the first free port from 7979)"
                                 AutomationProperties.AutomationId="ListenBox" AutomationProperties.Name="Listen on (auto, or an address and port)" />
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ToggleSwitch x:Name="MdnsToggle" Header="Found by name on this network (mDNS)"
                                          AutomationProperties.AutomationId="MdnsToggle" AutomationProperties.Name="Found by name on this network" />
                            <ToggleSwitch x:Name="PairToggle" Grid.Column="1" Header="Pairing with a code"
                                          AutomationProperties.AutomationId="PairToggle" AutomationProperties.Name="Pairing with a code" />
                        </Grid>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ToggleSwitch x:Name="WebTransportToggle" Header="WebTransport (QUIC) next to the WebSocket"
                                          AutomationProperties.AutomationId="WebTransportToggle" AutomationProperties.Name="WebTransport" />
                            <ToggleSwitch x:Name="TailscaleToggle" Grid.Column="1" Header="A real certificate from Tailscale"
                                          AutomationProperties.AutomationId="TailscaleToggle" AutomationProperties.Name="A real certificate from Tailscale" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="Relays" Style="{StaticResource Section}" AutomationProperties.HeadingLevel="Level2" />
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="14">
                        <TextBlock Style="{StaticResource Hint}" Text="For viewers on no network this computer shares (another building, a phone on mobile data): relays this computer waits on, one per line (ws:// or wss://)." />
                        <TextBox x:Name="RelaysBox" Header="Relays" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" PlaceholderText="wss://relay.example.com"
                                 AutomationProperties.AutomationId="RelaysBox" AutomationProperties.Name="Relays, one per line" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PasswordBox x:Name="RelaySecretBox" Header="The relays' secret for hosts" Width="320" PlaceholderText="Type a new one to change it"
                                         AutomationProperties.AutomationId="RelaySecretBox" AutomationProperties.Name="Relay secret (write only)" />
                            <TextBlock x:Name="RelaySecretState" VerticalAlignment="Bottom" Margin="0,0,0,6" Style="{StaticResource Hint}" AutomationProperties.AutomationId="RelaySecretState" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="Records" Style="{StaticResource Section}" AutomationProperties.HeadingLevel="Level2" />
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="14">
                        <TextBox x:Name="RecordBox" Header="Record sessions to this folder (MP4)" PlaceholderText="Empty: no recording"
                                 AutomationProperties.AutomationId="RecordBox" AutomationProperties.Name="Record sessions to this folder" />
                        <TextBox x:Name="AuditBox" Header="Audit log" PlaceholderText="Empty: audit.jsonl in the home folder; off: none"
                                 AutomationProperties.AutomationId="AuditBox" AutomationProperties.Name="Audit log file" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Start at login" Style="{StaticResource Section}" AutomationProperties.HeadingLevel="Level2" />
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="6">
                        <ToggleSwitch x:Name="StartAtLoginToggle" Header="Start rein-remote host when I sign in to Windows" Toggled="StartAtLogin_Toggled"
                                      AutomationProperties.AutomationId="StartAtLoginToggle" AutomationProperties.Name="Start rein-remote host when I sign in" />
                        <TextBlock x:Name="StartAtLoginDetail" Style="{StaticResource Hint}" AutomationProperties.AutomationId="StartAtLoginDetail" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Save bar -->
        <Border Grid.Row="1" Padding="24,12" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <InfoBar x:Name="SettingsResult" IsClosable="True" AutomationProperties.AutomationId="SettingsResult" AutomationProperties.Name="Settings result">
                    <InfoBar.ActionButton>
                        <Button x:Name="RestartSharing" Content="Restart sharing now" Click="Restart_Click" Visibility="Collapsed"
                                AutomationProperties.AutomationId="RestartSharing" AutomationProperties.Name="Restart sharing now" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="RevertSettings" Content="Undo changes" Click="Revert_Click"
                            AutomationProperties.AutomationId="RevertSettings" AutomationProperties.Name="Undo changes" />
                    <Button x:Name="SaveSettings" Content="Save" Style="{StaticResource AccentButtonStyle}" MinWidth="100" Click="Save_Click"
                            AutomationProperties.AutomationId="SaveSettings" AutomationProperties.Name="Save settings" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
